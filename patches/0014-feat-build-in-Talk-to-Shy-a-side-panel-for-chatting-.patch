diff --git a/chrome/browser/resources/talk_to_shy/manifest.json b/chrome/browser/resources/talk_to_shy/manifest.json
new file mode 100644
index 0000000000..7698399f24
--- /dev/null
+++ b/chrome/browser/resources/talk_to_shy/manifest.json
@@ -0,0 +1,32 @@
+{
+  "manifest_version": 3,
+  "name": "Talk to Shy",
+  "version": "0.2.1",
+  "description": "Lets an agent you trust read and use the sites you allow, with every call shown in a side panel.",
+  "key": "",
+  "icons": {
+    "128": "icon.png"
+  },
+  "permissions": [
+    "alarms",
+    "notifications",
+    "scripting",
+    "sidePanel",
+    "storage",
+    "tabs"
+  ],
+  "host_permissions": [
+    "<all_urls>"
+  ],
+  "background": {
+    "service_worker": "background.js",
+    "type": "module"
+  },
+  "side_panel": {
+    "default_path": "panel.html"
+  },
+  "action": {
+    "default_title": "Talk to Shy",
+    "default_icon": "icon.png"
+  }
+}
diff --git a/chrome/browser/resources/talk_to_shy/panel.css b/chrome/browser/resources/talk_to_shy/panel.css
new file mode 100644
index 0000000000..a9021f6298
--- /dev/null
+++ b/chrome/browser/resources/talk_to_shy/panel.css
@@ -0,0 +1,146 @@
+:root {
+  --bg: #f6f7f9;
+  --fg: #171a1f;
+  --muted: #5c6470;
+  --line: #d6dbe2;
+  --field: #ffffff;
+  --mine: #e4ecf7;
+  --ok: #1d7a4e;
+  --bad: #b3261e;
+  --wait: #9a6b00;
+  color-scheme: light;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #15181d;
+    --fg: #e7eaee;
+    --muted: #9aa3ae;
+    --line: #2e343c;
+    --field: #1d2127;
+    --mine: #23303f;
+    --ok: #5cc493;
+    --bad: #f08a80;
+    --wait: #e2b54f;
+    color-scheme: dark;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { height: 100%; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font: 13px/1.5 system-ui, sans-serif;
+  display: flex;
+  flex-direction: column;
+}
+[hidden] { display: none !important; }
+
+.bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 8px 12px;
+  border-bottom: 1px solid var(--line);
+}
+.actions { display: flex; gap: 4px; }
+.status { font-size: 12px; color: var(--muted); }
+.status::before { content: '●'; margin-right: 5px; color: var(--muted); }
+.status[data-state='connected']::before { color: var(--ok); }
+.status[data-state='connecting']::before { color: var(--wait); }
+.status[data-state='rejected']::before { color: var(--bad); }
+
+button {
+  font: inherit;
+  padding: 4px 12px;
+  border-radius: 6px;
+  border: 1px solid var(--line);
+  background: var(--field);
+  color: var(--fg);
+  cursor: pointer;
+}
+button:disabled { opacity: 0.5; cursor: default; }
+button.primary { border-color: var(--ok); color: var(--ok); font-weight: 600; }
+button.ghost { border-color: transparent; background: transparent; color: var(--muted); }
+button.ghost:hover { color: var(--fg); }
+input, textarea {
+  font: 12px ui-monospace, Menlo, monospace;
+  background: var(--field);
+  color: var(--fg);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 6px 8px;
+}
+input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 2px solid var(--wait); outline-offset: 1px; }
+
+.card { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; display: grid; gap: 6px; margin: 10px 12px 0; }
+.setup label { color: var(--muted); }
+.setup button { justify-self: start; }
+.approvals:empty { display: none; }
+.approval { border-color: var(--wait); }
+.approval p { margin: 0; }
+.approval .what { font-weight: 600; }
+.buttons { display: flex; flex-wrap: wrap; gap: 6px; }
+pre {
+  margin: 0;
+  max-height: 220px;
+  overflow: auto;
+  font: 11.5px/1.45 ui-monospace, Menlo, monospace;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 6px 8px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.meta { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
+
+.chat, .more { flex: 1; overflow-y: auto; padding: 12px; }
+.messages { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.message { display: grid; gap: 6px; max-width: 100%; }
+.message .text { white-space: pre-wrap; overflow-wrap: anywhere; }
+.message code { font: 12px ui-monospace, Menlo, monospace; background: var(--field); border-radius: 4px; padding: 0 3px; }
+.message a { color: inherit; }
+.message.user {
+  justify-self: end;
+  max-width: 85%;
+  background: var(--mine);
+  border-radius: 10px 10px 2px 10px;
+  padding: 6px 10px;
+}
+.message.error { color: var(--bad); font-size: 12px; }
+.message.waiting { color: var(--muted); font-size: 12px; }
+.reaction { justify-self: end; font-size: 12px; }
+.empty { margin: 0; color: var(--muted); }
+
+.more h2 { font-size: 11px; margin: 0 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
+.more h2:not(:first-child) { margin-top: 18px; }
+.log { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
+.log li { padding: 6px 0; border-bottom: 1px solid var(--line); }
+.log .call { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
+.log li[data-ok='false'] .call { color: var(--bad); }
+.settings { display: grid; gap: 6px; }
+.settings label { font-size: 12px; color: var(--muted); margin-top: 4px; }
+.settings label.check { display: flex; align-items: center; gap: 6px; color: var(--fg); }
+.check input { margin: 0; }
+textarea:disabled { opacity: 0.5; }
+.settings button { justify-self: start; margin-top: 6px; }
+.saved { color: var(--ok); font-size: 12px; }
+
+.composer {
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  padding: 10px 12px 12px;
+  border-top: 1px solid var(--line);
+}
+.composer textarea {
+  flex: 1;
+  resize: none;
+  font: 13px/1.45 system-ui, sans-serif;
+  padding: 8px 10px;
+  max-height: 160px;
+}

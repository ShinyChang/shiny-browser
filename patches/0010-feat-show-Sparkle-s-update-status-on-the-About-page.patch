+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_HELP_SPARKLE_UPDATER_MAC_H_
+#define CHROME_BROWSER_UI_WEBUI_HELP_SPARKLE_UPDATER_MAC_H_
+
+#include <string>
+
+#include "base/functional/callback_forward.h"
+
+// Shiny updates itself with Sparkle, which only a build published as an update
+// carries, together with the feed in its Info.plist.
+namespace sparkle_updater {
+
+enum class Result { kUpToDate, kUpdateAvailable, kBusy, kFailed };
+
+// `detail` is the new version for kUpdateAvailable and the reason for kFailed.
+using QuietCheckCallback =
+    base::OnceCallback<void(Result result, const std::u16string& detail)>;
+
+// Loads Sparkle when the app bundle ships it; idempotent.
+void Start();
+
+// False unless Start found Sparkle in the app bundle.
+bool IsAvailable();
+
+// Sparkle's own check, which shows its up-to-date or new-version window.
+void CheckWithUI();
+
+// Reads the feed without a window. kBusy means another check or an update
+// already holds Sparkle's session.
+void CheckQuietly(QuietCheckCallback callback);
+
+#if defined(__OBJC__)
+// The SPUStandardUpdaterController, a target for checkForUpdates: menu items.
+id Controller();
+#endif
+
+}  // namespace sparkle_updater
+
+#endif  // CHROME_BROWSER_UI_WEBUI_HELP_SPARKLE_UPDATER_MAC_H_
diff --git a/chrome/browser/ui/webui/help/sparkle_updater_mac.mm b/chrome/browser/ui/webui/help/sparkle_updater_mac.mm
new file mode 100644
index 0000000000..5f8a15af49
--- /dev/null
+++ b/chrome/browser/ui/webui/help/sparkle_updater_mac.mm
@@ -0,0 +1,150 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/help/sparkle_updater_mac.h"
+
+#import <Foundation/Foundation.h>
+
+#include <utility>
+#include <vector>
+
+#include "base/apple/bundle_locations.h"
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+
+// Sparkle is loaded at runtime, so its headers are not available; these are
+// the methods of SPUStandardUpdaterController, SPUUpdater and SUAppcastItem
+// used here.
+@protocol ShinySparkleController
+- (instancetype)initWithStartingUpdater:(BOOL)startUpdater
+                        updaterDelegate:(id)updaterDelegate
+                     userDriverDelegate:(id)userDriverDelegate;
+- (void)checkForUpdates:(id)sender;
+- (id)updater;
+@end
+
+@protocol ShinySparkleUpdater
+- (void)checkForUpdateInformation;
+- (BOOL)sessionInProgress;
+@end
+
+@protocol ShinySparkleAppcastItem
+- (NSString*)displayVersionString;
+@end
+
+@interface ShinySparkleDelegate : NSObject
+@end
+
+namespace sparkle_updater {
+namespace {
+
+// SPUUpdateCheckUpdateInformation and SUNoUpdateError in Sparkle's headers.
+constexpr NSInteger kQuietCheck = 2;
+constexpr NSInteger kNoUpdateError = 1001;
+
+id<ShinySparkleController> g_controller = nil;
+// Sparkle holds its delegate weakly.
+ShinySparkleDelegate* g_delegate = nil;
+NSString* g_found_version = nil;
+
+std::vector<QuietCheckCallback>& PendingChecks() {
+  static base::NoDestructor<std::vector<QuietCheckCallback>> checks;
+  return *checks;
+}
+
+void FinishQuietChecks(Result result, const std::u16string& detail) {
+  std::vector<QuietCheckCallback> checks = std::move(PendingChecks());
+  PendingChecks().clear();
+  for (QuietCheckCallback& check : checks) {
+    std::move(check).Run(result, detail);
+  }
+}
+
+}  // namespace
+}  // namespace sparkle_updater
+
+@implementation ShinySparkleDelegate
+
+- (void)updater:(id)updater didFindValidUpdate:(id<ShinySparkleAppcastItem>)item {
+  sparkle_updater::g_found_version = [item displayVersionString];
+}
+
+- (void)updater:(id)updater
+    didFinishUpdateCycleForUpdateCheck:(NSInteger)updateCheck
+                                 error:(NSError*)error {
+  using sparkle_updater::Result;
+  NSString* version = sparkle_updater::g_found_version;
+  sparkle_updater::g_found_version = nil;
+  if (updateCheck != sparkle_updater::kQuietCheck) {
+    return;
+  }
+  if (version) {
+    sparkle_updater::FinishQuietChecks(Result::kUpdateAvailable,
+                                       base::SysNSStringToUTF16(version));
+  } else if (!error || ([error.domain isEqualToString:@"SUSparkleErrorDomain"] &&
+                        error.code == sparkle_updater::kNoUpdateError)) {
+    sparkle_updater::FinishQuietChecks(Result::kUpToDate, std::u16string());
+  } else {
+    sparkle_updater::FinishQuietChecks(
+        Result::kFailed, base::SysNSStringToUTF16(error.localizedDescription));
+  }
+}
+
+@end
+
+namespace sparkle_updater {
+
+void Start() {
+  if (g_controller) {
+    return;
+  }
+  // Only builds published as updates carry Sparkle and a feed, so a build
+  // made from the patches alone never checks anywhere.
+  NSBundle* app = base::apple::OuterBundle();
+  if (![app objectForInfoDictionaryKey:@"SUFeedURL"]) {
+    return;
+  }
+  NSBundle* sparkle = [NSBundle
+      bundleWithPath:[app.privateFrameworksPath
+                         stringByAppendingPathComponent:@"Sparkle.framework"]];
+  Class controller =
+      [sparkle load] ? NSClassFromString(@"SPUStandardUpdaterController") : nil;
+  if (!controller) {
+    return;
+  }
+  g_delegate = [[ShinySparkleDelegate alloc] init];
+  g_controller = [[controller alloc] initWithStartingUpdater:YES
+                                             updaterDelegate:g_delegate
+                                          userDriverDelegate:nil];
+}
+
+bool IsAvailable() {
+  return g_controller != nil;
+}
+
+void CheckWithUI() {
+  [g_controller checkForUpdates:nil];
+}
+
+void CheckQuietly(QuietCheckCallback callback) {
+  if (!PendingChecks().empty()) {
+    PendingChecks().push_back(std::move(callback));
+    return;
+  }
+  id<ShinySparkleUpdater> updater = [g_controller updater];
+  // Sparkle ignores a quiet check while a session runs, so it would never end.
+  if (!updater || [updater sessionInProgress]) {
+    std::move(callback).Run(Result::kBusy, std::u16string());
+    return;
+  }
+  PendingChecks().push_back(std::move(callback));
+  [updater checkForUpdateInformation];
+}
+
+id Controller() {
+  return g_controller;
+}
+
+}  // namespace sparkle_updater

diff --git a/chrome/browser/resources/lottie_preview/background.js b/chrome/browser/resources/lottie_preview/background.js
new file mode 100644
index 0000000000..a8dbff1e47
--- /dev/null
+++ b/chrome/browser/resources/lottie_preview/background.js
@@ -0,0 +1,27 @@
+const VIEWER = chrome.runtime.getURL('viewer.html');
+
+// Static rulesets are read from disk, and a component extension served from
+// resources.pak has none, so the .lottie redirect is registered at runtime.
+async function registerRedirect() {
+  await chrome.declarativeNetRequest.updateDynamicRules({
+    removeRuleIds: [1],
+    addRules: [{
+      id: 1,
+      priority: 1,
+      action: { type: 'redirect', redirect: { regexSubstitution: `${VIEWER}#src=\\0` } },
+      condition: { regexFilter: '^https?://[^?#]*\\.lottie(\\?[^#]*)?$', resourceTypes: ['main_frame'] },
+    }],
+  });
+}
+
+chrome.runtime.onInstalled.addListener(registerRedirect);
+chrome.runtime.onStartup.addListener(registerRedirect);
+
+// declarativeNetRequest never sees file: URLs, so a local .lottie opened in the
+// browser arrives here as a download.
+chrome.downloads.onCreated.addListener((item) => {
+  const url = item.finalUrl || item.url;
+  if (!url.startsWith('file:') || !/\.lottie$/i.test(new URL(url).pathname)) return;
+  chrome.downloads.cancel(item.id, () => chrome.downloads.erase({ id: item.id }));
+  chrome.tabs.create({ url: `${VIEWER}#src=${url}` });
+});
diff --git a/chrome/browser/resources/lottie_preview/content.js b/chrome/browser/resources/lottie_preview/content.js
new file mode 100644
index 0000000000..e79c4a36b7
--- /dev/null
+++ b/chrome/browser/resources/lottie_preview/content.js
@@ -0,0 +1,41 @@
+// Chromium shows JSON documents as text in a <pre>; swap Lottie JSON for the player.
+(() => {
+  if (!/^(application|text)\/(json|plain|x-json)$/.test(document.contentType)) return;
+  const pre = document.body?.querySelector(':scope > pre');
+  if (!pre || document.body.children.length > 3) return;
+  const text = pre.textContent;
+  if (!text || text.length > 64 * 1024 * 1024 || text.trimStart()[0] !== '{') return;
+  let data;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    return;
+  }
+  const isLottie = typeof data.v === 'string' && typeof data.fr === 'number' &&
+    typeof data.ip === 'number' && typeof data.op === 'number' && Array.isArray(data.layers);
+  if (!isLottie) return;
+
+  const origin = new URL(chrome.runtime.getURL('')).origin;
+  const frame = document.createElement('iframe');
+  frame.src = chrome.runtime.getURL('viewer.html#embedded');
+  frame.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;border:0;z-index:2147483646';
+  frame.addEventListener('load', () =>
+    frame.contentWindow.postMessage({ type: 'lottie-preview:json', text, url: location.href }, origin));
+
+  const back = document.createElement('button');
+  back.textContent = 'Show preview';
+  back.hidden = true;
+  back.style.cssText = 'position:fixed;top:12px;right:12px;z-index:2147483647;font:13px system-ui;' +
+    'padding:6px 12px;border-radius:8px;border:1px solid #8884;background:Canvas;color:CanvasText;cursor:pointer';
+  back.addEventListener('click', () => {
+    frame.hidden = false;
+    back.hidden = true;
+  });
+
+  window.addEventListener('message', (event) => {
+    if (event.source !== frame.contentWindow || event.data?.type !== 'lottie-preview:raw') return;
+    frame.hidden = true;
+    back.hidden = false;
+  });
+  document.documentElement.append(frame, back);
+})();
diff --git a/chrome/browser/resources/lottie_preview/manifest.json b/chrome/browser/resources/lottie_preview/manifest.json
new file mode 100644
index 0000000000..9661b65a9e
--- /dev/null
+++ b/chrome/browser/resources/lottie_preview/manifest.json
@@ -0,0 +1,45 @@
+{
+  "manifest_version": 3,
+  "name": "Lottie Preview",
+  "version": "1.0.0",
+  "description": "Plays .lottie files and Lottie JSON instead of downloading them or showing raw text.",
+  "key": "",
+  "permissions": [
+    "declarativeNetRequestWithHostAccess",
+    "downloads"
+  ],
+  "host_permissions": [
+    "<all_urls>"
+  ],
+  "background": {
+    "service_worker": "background.js",
+    "type": "module"
+  },
+  "content_scripts": [
+    {
+      "matches": [
+        "<all_urls>"
+      ],
+      "js": [
+        "content.js"
+      ],
+      "run_at": "document_end"
+    }
+  ],
+  "web_accessible_resources": [
+    {
+      "resources": [
+        "viewer.html",
+        "viewer.css",
+        "viewer.js",
+        "vendor/*"
+      ],
+      "matches": [
+        "<all_urls>"
+      ]
+    }
+  ],
+  "content_security_policy": {
+    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
+  }
+}

new file mode 100644
index 0000000000..e766899006
--- /dev/null
+++ b/chrome/browser/ui/views/ide/ide_split.cc
@@ -0,0 +1,215 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <algorithm>
+#include <vector>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/ide/ide_internal.h"
+#include "chrome/browser/ui/views/ide/ide_palette.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/url_constants.h"
+#include "ui/views/controls/webview/webview.h"
+#include "url/gurl.h"
+
+namespace ide {
+
+namespace {
+
+using split_tabs::SplitTabLayout;
+
+enum class Direction { kLeft, kRight, kUp, kDown };
+
+constexpr double kResizeStep = 0.05;
+// The view enforces its own minimum pane size; this only keeps the stored
+// ratio from drifting so far past it that resizing back seems dead.
+constexpr double kMinRatio = 0.1;
+
+SplitTabLayout LayoutFor(Direction direction) {
+  return direction == Direction::kLeft || direction == Direction::kRight
+             ? SplitTabLayout::kSideBySide
+             : SplitTabLayout::kStacked;
+}
+
+// The first tab of a split is drawn on the left or on top.
+bool TowardsEnd(Direction direction) {
+  return direction == Direction::kRight || direction == Direction::kDown;
+}
+
+split_tabs::SplitTabData* ActiveSplit(TabStripModel* model) {
+  tabs::TabInterface* active = model->GetActiveTab();
+  if (!active || !active->IsSplit()) {
+    return nullptr;
+  }
+  return model->GetSplitData(*active->GetSplit());
+}
+
+// A split holds exactly two tabs, so splitting again only re-orients it.
+void Split(BrowserWindowInterface* browser, Direction direction) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (split_tabs::SplitTabData* split = ActiveSplit(model)) {
+    if (split->visual_data()->split_layout() != LayoutFor(direction)) {
+      model->UpdateSplitLayout(split->id(), LayoutFor(direction));
+    }
+    return;
+  }
+  chrome::NewSplitTab(browser, LayoutFor(direction),
+                      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  // NewSplitTab puts the new pane at the end.
+  if (!TowardsEnd(direction)) {
+    if (split_tabs::SplitTabData* split = ActiveSplit(model)) {
+      model->ReverseTabsInSplit(split->id());
+    }
+  }
+}
+
+// False when no pane lies in `direction`.
+bool FocusPane(BrowserWindowInterface* browser, Direction direction) {
+  TabStripModel* model = browser->GetTabStripModel();
+  split_tabs::SplitTabData* split = ActiveSplit(model);
+  if (!split || split->visual_data()->split_layout() != LayoutFor(direction)) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> tabs = split->ListTabs();
+  tabs::TabInterface* target =
+      TowardsEnd(direction) ? tabs.back() : tabs.front();
+  if (target->IsActivated()) {
+    return false;
+  }
+  model->ActivateTabAt(
+      model->GetIndexOfTab(target),
+      TabStripUserGestureDetails(
+          TabStripUserGestureDetails::GestureType::kKeyboard));
+  // BrowserView leaves focus alone on a tab change inside a split, because a
+  // click on the pane has already moved it; from the keyboard nothing has.
+  if (BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+    view->GetActiveContentsWebView()->RequestFocus();
+  }
+  return true;
+}
+
+// Moves the divider towards `direction`, whichever pane is active.
+void ResizePane(TabStripModel* model, Direction direction) {
+  split_tabs::SplitTabData* split = ActiveSplit(model);
+  if (!split || split->visual_data()->split_layout() != LayoutFor(direction)) {
+    return;
+  }
+  const double step = TowardsEnd(direction) ? kResizeStep : -kResizeStep;
+  model->UpdateSplitRatio(
+      split->id(), std::clamp(split->visual_data()->split_ratio() + step,
+                              kMinRatio, 1 - kMinRatio));
+}
+
+// Pages a pane shows until the user picks something; replacing one should
+// close it rather than leave it behind as a tab.
+bool IsPlaceholderPage(content::WebContents* contents) {
+  const GURL& url = contents->GetVisibleURL();
+  return url == GURL(chrome::kChromeUISplitViewNewTabPageURL) ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          (url.host() == chrome::kChromeUINewTabHost ||
+           url.host() == chrome::kChromeUINewTabPageHost));
+}
+
+}  // namespace
+
+void RunSplitCommand(BrowserWindowInterface* browser, int command_id) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (!model->GetActiveTab()) {
+    return;
+  }
+  switch (command_id) {
+    case IDC_IDE_SPLIT_RIGHT:
+      return Split(browser, Direction::kRight);
+    case IDC_IDE_SPLIT_LEFT:
+      return Split(browser, Direction::kLeft);
+    case IDC_IDE_SPLIT_DOWN:
+      return Split(browser, Direction::kDown);
+    case IDC_IDE_SPLIT_UP:
+      return Split(browser, Direction::kUp);
+    // With no pane that way the keys keep the meaning they had before.
+    case IDC_IDE_FOCUS_PANE_LEFT:
+      if (!FocusPane(browser, Direction::kLeft)) {
+        chrome::SelectPreviousTab(browser);
+      }
+      return;
+    case IDC_IDE_FOCUS_PANE_RIGHT:
+      if (!FocusPane(browser, Direction::kRight)) {
+        chrome::SelectNextTab(browser);
+      }
+      return;
+    case IDC_IDE_FOCUS_PANE_UP:
+      if (!FocusPane(browser, Direction::kUp)) {
+        chrome::ExecuteCommand(browser, IDC_FOCUS_PREVIOUS_PANE);
+      }
+      return;
+    case IDC_IDE_FOCUS_PANE_DOWN:
+      if (!FocusPane(browser, Direction::kDown)) {
+        chrome::ExecuteCommand(browser, IDC_FOCUS_NEXT_PANE);
+      }
+      return;
+    case IDC_IDE_RESIZE_PANE_LEFT:
+      return ResizePane(model, Direction::kLeft);
+    case IDC_IDE_RESIZE_PANE_RIGHT:
+      return ResizePane(model, Direction::kRight);
+    case IDC_IDE_RESIZE_PANE_UP:
+      return ResizePane(model, Direction::kUp);
+    case IDC_IDE_RESIZE_PANE_DOWN:
+      return ResizePane(model, Direction::kDown);
+    case IDC_IDE_EQUALIZE_PANES:
+      if (split_tabs::SplitTabData* split = ActiveSplit(model)) {
+        model->UpdateSplitRatio(split->id(), 0.5);
+      }
+      return;
+  }
+}
+
+bool IsSplit(BrowserWindowInterface* browser) {
+  return ActiveSplit(browser->GetTabStripModel()) != nullptr;
+}
+
+void SwapPanes(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (split_tabs::SplitTabData* split = ActiveSplit(model)) {
+    model->ReverseTabsInSplit(split->id());
+  }
+}
+
+void ExitSplit(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (split_tabs::SplitTabData* split = ActiveSplit(model)) {
+    model->RemoveSplit(split->id());
+  }
+}
+
+bool ShowInActivePane(BrowserWindowInterface* browser,
+                      content::WebContents* contents) {
+  TabStripModel* model = browser->GetTabStripModel();
+  tabs::TabInterface* active = model->GetActiveTab();
+  const int index = model->GetIndexOfWebContents(contents);
+  if (!active || !active->IsSplit() || index == TabStripModel::kNoTab) {
+    return false;
+  }
+  // A tab in a split, including this one, or a pinned tab keeps its place.
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  if (tab->IsSplit() || tab->IsPinned()) {
+    return false;
+  }
+  model->UpdateTabInSplit(active, index,
+                          IsPlaceholderPage(active->GetContents())
+                              ? TabStripModel::SplitUpdateType::kReplace
+                              : TabStripModel::SplitUpdateType::kSwap);
+  return true;
+}
+
+}  // namespace ide

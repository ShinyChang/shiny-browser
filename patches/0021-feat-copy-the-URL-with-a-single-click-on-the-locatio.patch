From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shiny <owner@shinychang.net>
Date: Wed, 28 Oct 2026 15:47:39 +0800
Subject: [PATCH] feat: copy the URL with a single click on the location bar
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- A single click on the unfocused URL copies it, shows the Link copied
  toast and leaves focus on the page.
- A double click or ⌘L still starts an edit; an empty location bar and
  right clicks behave as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BYkQJUafT3hpFT1kBmDgzX
---
 .../ui/views/omnibox/omnibox_view_views.cc    | 27 +++++++++++++++++++
 .../ui/views/omnibox/omnibox_view_views.h     |  3 +++
 2 files changed, 30 insertions(+)

diff --git a/chrome/browser/ui/views/omnibox/omnibox_view_views.cc b/chrome/browser/ui/views/omnibox/omnibox_view_views.cc
index 5be9f70d69..c5b7eea2b9 100644
--- a/chrome/browser/ui/views/omnibox/omnibox_view_views.cc
+++ b/chrome/browser/ui/views/omnibox/omnibox_view_views.cc
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "chrome/browser/ui/browser_commands.h"
 #include "chrome/browser/ui/views/omnibox/omnibox_view_views.h"
 
 #include <algorithm>
@@ -1412,6 +1413,21 @@ bool OmniboxViewViews::SupportsDrag() const {
 bool OmniboxViewViews::OnMousePressed(const ui::MouseEvent& event) {
   PermitExternalProtocolHandler();
 
+  // A click on the URL copies it rather than starting an edit, which a double
+  // click or ⌘L still does.
+  BrowserWindowInterface* const browser =
+      location_bar_view_ ? location_bar_view_->browser() : nullptr;
+  if (browser && !HasFocus() && !GetText().empty() &&
+      event.IsOnlyLeftMouseButton()) {
+    copy_on_release_ = event.GetClickCount() == 1;
+    if (!copy_on_release_) {
+      is_user_initiated_focus_ = true;
+      RequestFocus();
+      SelectAll(true);
+    }
+    return true;
+  }
+
   // Clear focus of buttons, but do not clear keyword mode.
   if (controller()->IsPopupOpen()) {
     OmniboxPopupSelection selection =
@@ -1524,6 +1540,9 @@ bool OmniboxViewViews::OnMousePressed(const ui::MouseEvent& event) {
 }
 
 bool OmniboxViewViews::OnMouseDragged(const ui::MouseEvent& event) {
+  if (copy_on_release_) {
+    return true;
+  }
   if (filter_drag_events_for_unelision_ &&
       !ExceededDragThreshold(event.root_location() -
                              GetLastClickRootLocation())) {
@@ -1549,6 +1568,14 @@ bool OmniboxViewViews::OnMouseDragged(const ui::MouseEvent& event) {
 void OmniboxViewViews::OnMouseReleased(const ui::MouseEvent& event) {
   PermitExternalProtocolHandler();
 
+  if (copy_on_release_) {
+    copy_on_release_ = false;
+    if (location_bar_view_ && location_bar_view_->browser()) {
+      chrome::ExecuteCommand(location_bar_view_->browser(), IDC_COPY_URL);
+    }
+    return;
+  }
+
   views::Textfield::OnMouseReleased(event);
   // When the user has clicked and released to give us focus, select all.
   if ((event.IsOnlyLeftMouseButton() || event.IsOnlyRightMouseButton()) &&
diff --git a/chrome/browser/ui/views/omnibox/omnibox_view_views.h b/chrome/browser/ui/views/omnibox/omnibox_view_views.h
index 35e574881d..a9d5fa694d 100644
--- a/chrome/browser/ui/views/omnibox/omnibox_view_views.h
+++ b/chrome/browser/ui/views/omnibox/omnibox_view_views.h
@@ -445,6 +445,9 @@ class OmniboxViewViews
   // True if any mouse button is currently depressed.
   bool is_mouse_pressed_ = false;
 
+  // Set by a single click on the unfocused URL, which copies it on release.
+  bool copy_on_release_ = false;
+
   // Applies a minimum threshold to drag events after unelision. Because the
   // text shifts after unelision, we don't want unintentional mouse drags to
   // change the selection.

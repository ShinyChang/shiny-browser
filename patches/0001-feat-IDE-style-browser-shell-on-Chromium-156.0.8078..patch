+class PaletteContents : public views::View, public views::TextfieldController {
+  METADATA_HEADER(PaletteContents, views::View)
+
+ public:
+  PaletteContents(BrowserWindowInterface* browser,
+                  PaletteMode mode,
+                  base::RepeatingClosure resize)
+      : browser_(browser), mode_(mode), resize_(std::move(resize)) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+
+    input_ = AddChildView(std::make_unique<views::Textfield>());
+    input_->set_controller(this);
+    input_->SetFontList(input_->GetFontList().DeriveWithSizeDelta(4));
+    input_->SetPlaceholderText(mode == PaletteMode::kGoto
+                                   ? u"Tabs, history, URL or search"
+                                   : u"Type a command");
+    input_->GetViewAccessibility().SetName(PaletteTitle(mode));
+
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    scroll->SetDrawOverflowIndicator(false);
+    scroll->ClipHeightTo(0, kListMaxHeight);
+    list_ = scroll->SetContents(std::make_unique<views::View>());
+    list_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+
+    footer_ = AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    footer_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    footer_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 6)));
+
+    Rebuild();
+  }
+  PaletteContents(const PaletteContents&) = delete;
+  PaletteContents& operator=(const PaletteContents&) = delete;
+  ~PaletteContents() override = default;
+
+  views::Textfield* input() { return input_; }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    Rebuild();
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed ||
+        sender->IsIMEComposing()) {
+      return false;
+    }
+    const bool control = key_event.IsControlDown();
+    switch (key_event.key_code()) {
+      case ui::VKEY_DOWN:
+        MoveSelection(1);
+        return true;
+      case ui::VKEY_UP:
+        MoveSelection(-1);
+        return true;
+      case ui::VKEY_N:
+        if (control) {
+          MoveSelection(1);
+          return true;
+        }
+        break;
+      case ui::VKEY_P:
+        if (control) {
+          MoveSelection(-1);
+          return true;
+        }
+        break;
+      case ui::VKEY_RETURN:
+        Accept(selected_);
+        return true;
+      case ui::VKEY_ESCAPE:
+        GetWidget()->Close();
+        return true;
+      default:
+        break;
+    }
+    return false;
+  }
+
+ private:
+  std::u16string Query() const {
+    return std::u16string(
+        base::TrimWhitespace(input_->GetText(), base::TRIM_ALL));
+  }
+
+  void Rebuild() {
+    ++generation_;
+    history_tracker_.TryCancelAll();
+    history_.clear();
+    sync_items_.clear();
+    has_navigate_item_ = false;
+    navigate_first_ = false;
+    const std::u16string query = Query();
+    if (mode_ == PaletteMode::kGoto) {
+      BuildGotoItems(query);
+      if (!query.empty()) {
+        QueryHistory(query);
+      }
+    } else {
+      BuildCommandItems(query);
+    }
+    Render(/*reset_selection=*/true);
+  }
+
+  void BuildGotoItems(const std::u16string& query) {
+    Profile* profile = browser_->GetProfile();
+    content::WebContents* current =
+        browser_->GetTabStripModel()->GetActiveWebContents();
+
+    std::vector<Item> tabs;
+    tab_count_ = 0;
+    ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+            return true;
+          }
+          TabStripModel* model = browser->GetTabStripModel();
+          for (int i = 0; i < model->count(); ++i) {
+            content::WebContents* contents = model->GetWebContentsAt(i);
+            ++tab_count_;
+            if (contents == current) {
+              continue;
+            }
+            Item item;
+            item.kind = Item::Kind::kOpenTab;
+            item.row.title = contents->GetTitle();
+            item.url = contents->GetLastCommittedURL();
+            item.row.detail = DisplayUrl(item.url);
+            if (!Score(query, &item)) {
+              continue;
+            }
+            item.row.icon = GetFavicon(contents);
+            if (contents->IsCurrentlyAudible()) {
+              item.row.hint = u"Playing";
+            }
+            item.contents = contents->GetWeakPtr();
+            item.recency = LastFocused(contents);
+            tabs.push_back(std::move(item));
+          }
+          return true;
+        },
+        BrowserCollection::Order::kActivation);
+    SortAndTrim(&tabs, query.empty() ? kMaxTabs + 3 : kMaxTabs);
+
+    std::vector<Item> closed;
+    if (auto* restore = TabRestoreServiceFactory::GetForProfile(profile)) {
+      const base::Time now = base::Time::Now();
+      for (const auto& entry : restore->entries()) {
+        if (entry->type != sessions::tab_restore::TAB) {
+          continue;
+        }
+        const auto& tab = static_cast<const sessions::tab_restore::Tab&>(*entry);
+        if (tab.navigations.empty()) {
+          continue;
+        }
+        const auto& navigation =
+            tab.navigations[tab.normalized_navigation_index()];
+        Item item;
+        item.kind = Item::Kind::kClosed;
+        item.url = navigation.virtual_url();
+        item.row.title = navigation.title().empty()
+                             ? DisplayUrl(item.url)
+                             : navigation.title();
+        item.row.detail = DisplayUrl(item.url);
+        if (!Score(query, &item)) {
+          continue;
+        }
+        item.row.icon = ui::ImageModel::FromVectorIcon(
+            vector_icons::kHistoryIcon, ui::kColorIcon, 16);
+        item.row.hint =
+            ui::TimeFormat::Simple(ui::TimeFormat::FORMAT_ELAPSED,
+                                   ui::TimeFormat::LENGTH_SHORT,
+                                   now - entry->timestamp);
+        item.recency = entry->timestamp;
+        closed.push_back(std::move(item));
+      }
+    }
+    SortAndTrim(&closed, kMaxClosed);
+
+    if (query.empty()) {
+      Item new_tab;
+      new_tab.kind = Item::Kind::kNewTab;
+      new_tab.row.title = u"New Tab";
+      new_tab.row.icon = ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, ui::kColorIcon, 16);
+      new_tab.row.hint = u"↵";
+      sync_items_.push_back(std::move(new_tab));
+    } else {
+      AutocompleteMatch match;
+      AutocompleteClassifierFactory::GetForProfile(profile)->Classify(
+          query, false, false, metrics::OmniboxEventProto::INVALID_SPEC, &match,
+          nullptr);
+      if (match.destination_url.is_valid()) {
+        const bool is_search = AutocompleteMatch::IsSearchType(match.type);
+        navigate_item_ = Item();
+        navigate_item_.kind = Item::Kind::kNavigate;
+        navigate_item_.url = match.destination_url;
+        navigate_item_.row.title =
+            is_search ? u"Search for “" + query + u"”"
+                      : u"Open " + DisplayUrl(match.destination_url);
+        navigate_item_.row.icon = ui::ImageModel::FromVectorIcon(
+            is_search ? vector_icons::kSearchIcon : vector_icons::kGlobeIcon,
+            ui::kColorIcon, 16);
+        navigate_item_.row.hint = u"New tab";
+        has_navigate_item_ = true;
+        navigate_first_ = !is_search;
+      } else {
+        has_navigate_item_ = false;
+      }
+    }
+
+    for (Item& item : tabs) {
+      sync_items_.push_back(std::move(item));
+    }
+    closed_ = std::move(closed);
+  }
+
+  void BuildCommandItems(const std::u16string& query) {
+    has_navigate_item_ = false;
+    closed_.clear();
+    std::vector<Item> commands;
+    for (const Command& command : kCommands) {
+      if (command.id > 0 && !chrome::IsCommandEnabled(browser_, command.id)) {
+        continue;
+      }
+      Item item;
+      item.kind = Item::Kind::kCommand;
+      item.command = command.id;
+      item.row.title = command.label;
+      item.score = FuzzyScore(query, item.row.title, &item.row.title_matches);
+      if (item.score < 0) {
+        continue;
+      }
+      if (command.id > 0) {
+        item.row.hint = ShortcutForCommand(command.id);
+      }
+      commands.push_back(std::move(item));
+    }
+    std::stable_sort(commands.begin(), commands.end(),
+                     [](const Item& a, const Item& b) {
+                       return a.score > b.score;
+                     });
+    sync_items_ = std::move(commands);
+  }
+
+  // Scores `item` against its title and URL; false drops it.
+  bool Score(const std::u16string& query, Item* item) {
+    std::vector<gfx::Range> title_matches;
+    const int title_score =
+        FuzzyScore(query, item->row.title, &title_matches);
+    const int url_score = FuzzyScore(query, item->row.detail, nullptr);
+    if (title_score < 0 && url_score < 0) {
+      return false;
+    }
+    if (title_score >= url_score) {
+      item->row.title_matches = std::move(title_matches);
+    }
+    item->score = std::max(title_score, url_score);
+    return true;
+  }
+
+  static void SortAndTrim(std::vector<Item>* items, size_t max) {
+    std::stable_sort(items->begin(), items->end(),
+                     [](const Item& a, const Item& b) {
+                       if (a.score != b.score) {
+                         return a.score > b.score;
+                       }
+                       return a.recency > b.recency;
+                     });
+    if (items->size() > max) {
+      items->resize(max);
+    }
+  }
+
+  void QueryHistory(const std::u16string& query) {
+    history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+        browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    if (!history) {
+      return;
+    }
+    history::QueryOptions options;
+    options.max_count = 40;
+    options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+    history->QueryHistory(
+        query, options,
+        base::BindOnce(&PaletteContents::OnHistoryResults,
+                       weak_factory_.GetWeakPtr(), generation_, query),
+        &history_tracker_);
+  }
+
+  void OnHistoryResults(int generation,
+                        std::u16string query,
+                        history::QueryResults results) {
+    if (generation != generation_) {
+      return;
+    }
+    std::vector<Item> history;
+    for (const history::URLResult& result : results) {
+      Item item;
+      item.kind = Item::Kind::kHistory;
+      item.url = result.url();
+      if (IsAlreadyListed(item.url)) {
+        continue;
+      }
+      item.row.title =
+          result.title().empty() ? DisplayUrl(item.url) : result.title();
+      item.row.detail = DisplayUrl(item.url);
+      if (!Score(query, &item)) {
+        continue;
+      }
+      item.row.icon = ui::ImageModel::FromVectorIcon(
+          vector_icons::kHistoryIcon, ui::kColorIcon, 16);
+      item.recency = result.visit_time();
+      history.push_back(std::move(item));
+    }
+    SortAndTrim(&history, kMaxHistory);
+    history_ = std::move(history);
+    Render(/*reset_selection=*/false);
+  }
+
+  bool IsAlreadyListed(const GURL& url) const {
+    for (const Item& item : sync_items_) {
+      if (item.url == url) {
+        return true;
+      }
+    }
+    for (const Item& item : closed_) {
+      if (item.url == url) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Render(bool reset_selection) {
+    shown_.clear();
+    if (navigate_first_ && has_navigate_item_) {
+      shown_.push_back(navigate_item_);
+    }
+    for (const Item& item : sync_items_) {
+      shown_.push_back(item);
+    }
+    for (const Item& item : history_) {
+      shown_.push_back(item);
+    }
+    for (const Item& item : closed_) {
+      shown_.push_back(item);
+    }
+    if (!navigate_first_ && has_navigate_item_) {
+      shown_.push_back(navigate_item_);
+    }
+    if (reset_selection || selected_ >= shown_.size()) {
+      selected_ = 0;
+    }
+
+    rows_.clear();
+    list_->RemoveAllChildViews();
+    const char16_t* last_section = nullptr;
+    for (size_t i = 0; i < shown_.size(); ++i) {
+      const char16_t* section = SectionTitle(shown_[i].kind);
+      if (section && section != last_section) {
+        list_->AddChildView(CreateSectionHeader(section));
+      }
+      last_section = section;
+      rows_.push_back(list_->AddChildView(CreateRow(
+          shown_[i].row, i == selected_,
+          base::BindRepeating(&PaletteContents::Accept, base::Unretained(this),
+                              i),
+          base::BindRepeating(&PaletteContents::Select, base::Unretained(this),
+                              i))));
+    }
+    if (shown_.empty()) {
+      list_->AddChildView(CreateSectionHeader(u"No matches"));
+    }
+
+    footer_->SetText(
+        mode_ == PaletteMode::kGoto
+            ? u"↑↓ select   ↵ open   esc close   ⌘⇧P commands   " +
+                  base::NumberToString16(tab_count_) + u" tabs open"
+            : u"↑↓ select   ↵ run   esc close   ⌘T tabs and URLs");
+    list_->InvalidateLayout();
+    resize_.Run();
+    if (selected_ < rows_.size()) {
+      rows_[selected_]->ScrollViewToVisible();
+    }
+  }
+
+  void Select(size_t index) {
+    if (index >= rows_.size() || index == selected_) {
+      return;
+    }
+    if (selected_ < rows_.size()) {
+      SetRowSelected(rows_[selected_], false);
+    }
+    selected_ = index;
+    SetRowSelected(rows_[selected_], true);
+    rows_[selected_]->ScrollViewToVisible();
+  }
+
+  void MoveSelection(int delta) {
+    if (rows_.empty()) {
+      return;
+    }
+    const int count = static_cast<int>(rows_.size());
+    Select(static_cast<size_t>(
+        (static_cast<int>(selected_) + delta + count) % count));
+  }
+
+  void Accept(size_t index) {
+    if (index >= shown_.size()) {
+      return;
+    }
+    // Run after the bubble has gone so focus restoration cannot undo what the
+    // action focuses (find bar, location bar, a new tab).
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ActOn, base::Unretained(browser_.get()),
+                                  shown_[index]));
+    GetWidget()->Close();
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  const PaletteMode mode_;
+  base::RepeatingClosure resize_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::View> list_ = nullptr;
+  raw_ptr<views::Label> footer_ = nullptr;
+  std::vector<raw_ptr<views::View>> rows_;
+  std::vector<Item> sync_items_;
+  std::vector<Item> closed_;
+  std::vector<Item> history_;
+  std::vector<Item> shown_;
+  Item navigate_item_;
+  bool has_navigate_item_ = false;
+  bool navigate_first_ = false;
+  size_t selected_ = 0;
+  int tab_count_ = 0;
+  int generation_ = 0;
+  base::CancelableTaskTracker history_tracker_;
+  base::WeakPtrFactory<PaletteContents> weak_factory_{this};
+};

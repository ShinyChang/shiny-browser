+std::unique_ptr<views::View> CreateRow(const RowSpec& spec,
+                                       bool selected,
+                                       base::RepeatingClosure on_click,
+                                       base::RepeatingClosure on_hover) {
+  auto row =
+      std::make_unique<RowView>(std::move(on_click), std::move(on_hover));
+  auto* layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(6, 10), 10));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  auto* icon = row->AddChildView(std::make_unique<views::ImageView>());
+  icon->SetImageSize(gfx::Size(16, 16));
+  icon->SetPreferredSize(gfx::Size(16, 16));
+  if (!spec.icon.IsEmpty()) {
+    icon->SetImage(spec.icon);
+  }
+
+  auto* text = row->AddChildView(std::make_unique<views::View>());
+  text->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 1));
+  layout->SetFlexForView(text, 1);
+
+  // Pre-elided so the styled title stays on one line; StyledLabel wraps
+  // instead of eliding.
+  const gfx::FontList& font = views::TypographyProvider::Get().GetFont(
+      views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY);
+  const std::u16string title =
+      gfx::ElideText(spec.title, font, kTitleWidth, gfx::ELIDE_TAIL);
+  auto* title_label = text->AddChildView(std::make_unique<views::StyledLabel>());
+  title_label->SetText(title);
+  for (const gfx::Range& range : spec.title_matches) {
+    const gfx::Range clipped(std::min<size_t>(range.start(), title.size()),
+                             std::min<size_t>(range.end(), title.size()));
+    if (clipped.is_empty()) {
+      continue;
+    }
+    views::StyledLabel::RangeStyleInfo style;
+    style.text_style = views::style::STYLE_EMPHASIZED;
+    title_label->AddStyleRange(clipped, style);
+  }
+  title_label->SizeToFit(0);
+
+  if (!spec.detail.empty()) {
+    auto* detail = text->AddChildView(std::make_unique<views::Label>(
+        spec.detail, views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    detail->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    detail->SetElideBehavior(gfx::ELIDE_TAIL);
+    detail->SetMaximumWidthSingleLine(kTitleWidth);
+  }
+
+  if (!spec.hint.empty()) {
+    row->AddChildView(std::make_unique<views::Label>(
+        spec.hint, views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+  }
+
+  SetRowSelected(row.get(), selected);
+  return row;
+}
+
+void SetRowSelected(views::View* row, bool selected) {
+  row->SetBackground(selected ? views::CreateRoundedRectBackground(
+                                    ui::kColorMenuItemBackgroundSelected,
+                                    kRowRadius)
+                              : nullptr);
+}
+
+std::unique_ptr<views::View> CreateSectionHeader(const std::u16string& text) {
+  auto label = std::make_unique<views::Label>(
+      text, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(8, 10, 2, 10)));
+  return label;
+}
+
+gfx::Rect GetPaletteAnchorRect(BrowserWindowInterface* browser) {
+  const gfx::Rect bounds =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetBoundsInScreen();
+  return gfx::Rect(bounds.CenterPoint().x(), bounds.y() + 72, 0, 0);
+}
+
+ui::ImageModel GetFavicon(content::WebContents* contents) {
+  if (auto* driver =
+          favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    const gfx::Image image = driver->GetFavicon();
+    if (!image.IsEmpty()) {
+      return ui::ImageModel::FromImage(image);
+    }
+  }
+  return ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon,
+                                        ui::kColorIcon, 16);
+}
+
+bool ActivateContents(content::WebContents* contents) {
+  bool found = false;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        TabStripModel* model = browser->GetTabStripModel();
+        const int index = model->GetIndexOfWebContents(contents);
+        if (index == TabStripModel::kNoTab) {
+          return true;
+        }
+        browser->GetWindow()->Activate();
+        model->ActivateTabAt(index);
+        found = true;
+        return false;
+      });
+  return found;
+}
+
+void ShowPalette(BrowserWindowInterface* browser, PaletteMode mode) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget()) {
+    return;
+  }
+  auto palette = std::make_unique<PaletteBubble>(browser, mode);
+  palette->set_parent_window(browser_view->GetWidget()->GetNativeView());
+  palette->SetAnchorRect(GetPaletteAnchorRect(browser));
+  PaletteHolder().Show(std::move(palette), /*activate=*/true);
+}
+
+}  // namespace ide

+
+class MruSession {
+ public:
+  static MruSession& Get() {
+    static base::NoDestructor<MruSession> session;
+    return *session;
+  }
+
+  void Step(BrowserWindowInterface* browser, bool reverse) {
+    if (!active_) {
+      Begin(browser);
+      if (entries_.size() < 2) {
+        End();
+        return;
+      }
+    }
+    const size_t count = entries_.size();
+    position_ = reverse ? (position_ + count - 1) % count
+                        : (position_ + 1) % count;
+    if (MruOverlayBubble* overlay = Overlay()) {
+      overlay->Select(position_);
+    }
+    // Menu clicks and taps already released arrive with Control up.
+    if (!IsControlKeyDown()) {
+      Commit();
+    }
+  }
+
+ private:
+  struct Entry {
+    base::WeakPtr<content::WebContents> contents;
+    RowSpec row;
+  };
+
+  static Entry MakeEntry(content::WebContents* contents) {
+    Entry entry;
+    entry.contents = contents->GetWeakPtr();
+    entry.row.icon = GetFavicon(contents);
+    entry.row.title = contents->GetTitle();
+    entry.row.detail = url_formatter::FormatUrl(
+        contents->GetLastCommittedURL(),
+        url_formatter::kFormatUrlOmitDefaults |
+            url_formatter::kFormatUrlOmitHTTPS |
+            url_formatter::kFormatUrlOmitTrivialSubdomains,
+        base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+    if (contents->IsCurrentlyAudible()) {
+      entry.row.hint = u"Playing";
+    }
+    return entry;
+  }
+
+  void Begin(BrowserWindowInterface* browser) {
+    entries_.clear();
+    position_ = 0;
+    browser_ = browser;
+    started_ = base::TimeTicks::Now();
+
+    content::WebContents* current =
+        browser->GetTabStripModel()->GetActiveWebContents();
+    std::vector<std::pair<base::Time, content::WebContents*>> others;
+    ProfileBrowserCollection::GetForProfile(browser->GetProfile())
+        ->ForEach(
+            [&](BrowserWindowInterface* candidate) {
+              if (candidate->GetType() !=
+                  BrowserWindowInterface::Type::TYPE_NORMAL) {
+                return true;
+              }
+              TabStripModel* model = candidate->GetTabStripModel();
+              for (int i = 0; i < model->count(); ++i) {
+                content::WebContents* contents = model->GetWebContentsAt(i);
+                if (contents == current) {
+                  continue;
+                }
+                auto* unit = resource_coordinator::TabLifecycleUnitExternal::
+                    FromWebContents(contents);
+                others.emplace_back(
+                    unit ? unit->GetLastFocusedTime() : base::Time(),
+                    contents);
+              }
+              return true;
+            },
+            BrowserCollection::Order::kActivation);
+    std::stable_sort(others.begin(), others.end(),
+                     [](const auto& a, const auto& b) {
+                       return a.first > b.first;
+                     });
+
+    if (current) {
+      entries_.push_back(MakeEntry(current));
+    }
+    for (const auto& [time, contents] : others) {
+      if (entries_.size() >= kMaxEntries) {
+        break;
+      }
+      entries_.push_back(MakeEntry(contents));
+    }
+    active_ = true;
+    timer_.Start(FROM_HERE, kPollInterval,
+                 base::BindRepeating(&MruSession::Poll,
+                                     base::Unretained(this)));
+  }
+
+  void Poll() {
+    if (!IsControlKeyDown()) {
+      Commit();
+      return;
+    }
+    if (!Overlay() && base::TimeTicks::Now() - started_ >= kOverlayDelay) {
+      ShowOverlay();
+    }
+  }
+
+  void ShowOverlay() {
+    BrowserView* browser_view =
+        browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+    if (!browser_view || !browser_view->GetWidget()) {
+      return;
+    }
+    std::vector<RowSpec> rows;
+    for (const Entry& entry : entries_) {
+      rows.push_back(entry.row);
+    }
+    auto overlay = std::make_unique<MruOverlayBubble>(rows, position_);
+    overlay->set_parent_window(browser_view->GetWidget()->GetNativeView());
+    overlay->SetAnchorRect(GetPaletteAnchorRect(browser_));
+    overlay_.Show(std::move(overlay), /*activate=*/false);
+  }
+
+  void Commit() {
+    content::WebContents* target = position_ < entries_.size()
+                                       ? entries_[position_].contents.get()
+                                       : nullptr;
+    End();
+    if (target) {
+      ActivateContents(target);
+    }
+  }
+
+  void End() {
+    timer_.Stop();
+    active_ = false;
+    entries_.clear();
+    position_ = 0;
+    browser_ = nullptr;
+    overlay_.Close();
+  }
+
+  MruOverlayBubble* Overlay() {
+    return static_cast<MruOverlayBubble*>(overlay_.delegate());
+  }
+
+  bool active_ = false;
+  std::vector<Entry> entries_;
+  size_t position_ = 0;
+  base::TimeTicks started_;
+  // Only held while Control is down; cleared in End().
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  base::RepeatingTimer timer_;
+  BubbleHolder overlay_;
+};
+
+}  // namespace

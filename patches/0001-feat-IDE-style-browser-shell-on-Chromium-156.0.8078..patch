+
+BubbleHolder::BubbleHolder() = default;
+BubbleHolder::~BubbleHolder() = default;
+
+void BubbleHolder::Show(std::unique_ptr<views::BubbleDialogDelegate> delegate,
+                        bool activate) {
+  Close();
+  delegate_ = std::move(delegate);
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&BubbleHolder::OnClosed,
+                                      weak_factory_.GetWeakPtr(),
+                                      ++generation_));
+  if (activate) {
+    widget_->Show();
+  } else {
+    widget_->ShowInactive();
+  }
+}
+
+void BubbleHolder::Close() {
+  if (widget_ && !widget_->IsClosed()) {
+    widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  }
+  OnClosed(generation_, views::Widget::ClosedReason::kUnspecified);
+}
+
+void BubbleHolder::OnClosed(int generation,
+                            views::Widget::ClosedReason reason) {
+  if (generation != generation_) {
+    return;
+  }
+  // The delegate must outlive its widget, so it is queued second.
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  if (widget_) {
+    runner->DeleteSoon(FROM_HERE, std::move(widget_));
+  }
+  if (delegate_) {
+    runner->DeleteSoon(FROM_HERE, std::move(delegate_));
+  }
+}

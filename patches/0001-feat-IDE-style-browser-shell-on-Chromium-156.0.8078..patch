+// Case-insensitive match of every whitespace-separated token of `query`; a
+// contiguous hit outranks a scattered subsequence. Returns -1 on a miss.
+int FuzzyScore(const std::u16string& query,
+               const std::u16string& text,
+               std::vector<gfx::Range>* matches) {
+  if (query.empty()) {
+    return 0;
+  }
+  const std::u16string haystack = base::i18n::ToLower(text);
+  int total = 0;
+  for (const std::u16string& token :
+       base::SplitString(base::i18n::ToLower(query), u" ",
+                         base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const size_t exact = haystack.find(token);
+    if (exact != std::u16string::npos) {
+      int score = 20 + static_cast<int>(token.size()) * 6;
+      if (exact == 0 || !base::IsAsciiAlphaNumeric(haystack[exact - 1])) {
+        score += 15;
+      }
+      if (matches) {
+        matches->emplace_back(exact, exact + token.size());
+      }
+      total += score;
+      continue;
+    }
+    size_t matched = 0;
+    size_t last = std::u16string::npos;
+    int score = 0;
+    for (size_t i = 0; i < haystack.size() && matched < token.size(); ++i) {
+      if (haystack[i] != token[matched]) {
+        continue;
+      }
+      score += 1;
+      if (i == 0 || !base::IsAsciiAlphaNumeric(haystack[i - 1])) {
+        score += 6;
+      }
+      if (last != std::u16string::npos && last + 1 == i) {
+        score += 3;
+      }
+      if (matches) {
+        if (!matches->empty() && matches->back().end() == i) {
+          matches->back() = gfx::Range(matches->back().start(), i + 1);
+        } else {
+          matches->emplace_back(i, i + 1);
+        }
+      }
+      last = i;
+      ++matched;
+    }
+    if (matched < token.size()) {
+      return -1;
+    }
+    total += score;
+  }
+  return total;
+}
+
+std::u16string DisplayUrl(const GURL& url) {
+  return url_formatter::FormatUrl(
+      url,
+      url_formatter::kFormatUrlOmitDefaults |
+          url_formatter::kFormatUrlOmitHTTPS |
+          url_formatter::kFormatUrlOmitTrivialSubdomains,
+      base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+}
+
+base::Time LastFocused(content::WebContents* contents) {
+  auto* unit =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  return unit ? unit->GetLastFocusedTime() : base::Time();
+}
+
+bool IsBrowserAlive(BrowserWindowInterface* browser) {
+  bool alive = false;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        alive = candidate == browser;
+        return !alive;
+      });
+  return alive;
+}
+
+void Navigate(BrowserWindowInterface* browser, const GURL& url) {
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  ::Navigate(&params);
+}
+
+void RunCommand(BrowserWindowInterface* browser, int command) {
+  switch (command) {
+    case kShowDownloadsBubble:
+      if (auto* controller = DownloadToolbarUIController::From(browser)) {
+        controller->InvokeUI();
+      }
+      return;
+    case kDownloadLocation:
+      Navigate(browser, GURL("chrome://settings/downloads"));
+      return;
+    case kCloseIdleTabsNow:
+      CloseIdleTabs(kIdleTabLimit);
+      return;
+    default:
+      chrome::ExecuteCommand(browser, command);
+  }
+}
+
+void ActOn(BrowserWindowInterface* browser, Item item) {
+  if (!IsBrowserAlive(browser)) {
+    return;
+  }
+  switch (item.kind) {
+    case Item::Kind::kNewTab:
+      chrome::ExecuteCommand(browser, IDC_NEW_TAB);
+      return;
+    case Item::Kind::kOpenTab:
+      if (item.contents) {
+        ActivateContents(item.contents.get());
+      }
+      return;
+    case Item::Kind::kHistory:
+    case Item::Kind::kClosed:
+    case Item::Kind::kNavigate:
+      Navigate(browser, item.url);
+      return;
+    case Item::Kind::kCommand:
+      RunCommand(browser, item.command);
+      return;
+  }
+}

+#if !BUILDFLAG(IS_MAC)
+bool IsControlKeyDown() {
+  return false;
+}
+#endif
+
+void CycleMruTab(BrowserWindowInterface* browser, bool reverse) {
+  MruSession::Get().Step(browser, reverse);
+}

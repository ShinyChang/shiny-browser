+#!/usr/bin/env node
+// Runtime smoke test for the Chromium IDE build. Drives the real app with
+// keystrokes, so it takes focus for about two minutes.
+//
+//   node smoke.mjs [--app /Applications/Shiny.app] [--shots DIR] [--video FILE] [--pace MS] [--keep] [--force]
+//
+// Exit code 0 only when every check passes.
+import { execFileSync, spawn } from 'node:child_process';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+
+const argv = process.argv.slice(2);
+const opt = (name, fallback) => {
+  const i = argv.indexOf(name);
+  return i >= 0 ? argv[i + 1] : fallback;
+};
+const APP = opt('--app', '/Applications/Shiny.app');
+const plist = (key) => {
+  try {
+    return execFileSync('plutil', ['-extract', key, 'raw', path.join(APP, 'Contents/Info.plist')], { encoding: 'utf8' }).trim();
+  } catch {
+    return '';
+  }
+};
+// System Events names the process after the bundle, which follows BRANDING.
+const PROC = plist('CFBundleName') || 'Chromium';
+const SHOTS = opt('--shots', null);
+const VIDEO = opt('--video', null);
+const KEEP = argv.includes('--keep');
+// Extra pause after each keystroke so a recording is watchable.
+const PACE = Number(opt('--pace', 0));
+const CDP_PORT = 9333;
+const UIDT_PORT = 9334;
+const HTTP_PORT = 8767;
+const BASE = `http://127.0.0.1:${HTTP_PORT}`;
+const WINDOW = { left: 160, top: 120, width: 1400, height: 860 };
+const CRASH_DIR = path.join(os.homedir(), 'Library/Application Support/Chromium IDE/Crashpad/pending');
+
+const work = fs.mkdtempSync(path.join(os.tmpdir(), 'chromium-ide-smoke-'));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+// ---------------------------------------------------------------- keyboard
+
+const osa = (...lines) =>
+  execFileSync('osascript', lines.flatMap((l) => ['-e', l]), { encoding: 'utf8' }).trim();
+
+// Key codes, not characters: with a Zhuyin input source, `keystroke "t"` adds
+// Option to produce "t", turning Cmd+T into Cmd+Opt+T.
+const KC = { a: 0, t: 17, p: 35, l: 37, w: 13, v: 9, i: 34, tab: 48, ret: 36, esc: 53 };
+
+const sleepSync = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
+
+// Activation is asynchronous, so poll until the browser really is in front.
+function frontmost() {
+  for (let i = 0; i < 10; i++) {
+    if (osa(`tell application "System Events" to get frontmost of process "${PROC}"`) === 'true') return;
+    osa(`tell application "System Events" to tell process "${PROC}" to set frontmost to true`);
+    sleepSync(200);
+  }
+}
+
+function key(code, mods = []) {
+  frontmost();
+  const using = mods.length ? ` using {${mods.map((m) => `${m} down`).join(', ')}}` : '';
+  osa(
+    `tell application "System Events" to if not (frontmost of process "${PROC}") then error "${PROC} not frontmost"`,
+    `tell application "System Events" to key code ${code}${using}`,
+  );
+  if (PACE) sleepSync(PACE);
+}
+
+// Typing would go through the input method, so text is pasted instead and the
+// previous clipboard text is restored.
+async function paste(text) {
+  let saved = null;
+  try {
+    saved = execFileSync('pbpaste', { encoding: 'utf8' });
+  } catch {}
+  execFileSync('pbcopy', { input: text });
+  key(KC.v, ['command']);
+  await sleep(300);
+  execFileSync('pbcopy', { input: saved ?? '' });
+}
+
+const windowTitle = () =>
+  osa(`tell application "System Events" to tell process "${PROC}" to get name of window 1`);
+
+// ---------------------------------------------------------------- CDP
+
+class Cdp {
+  static async connect() {
+    const ver = await (await fetch(`http://127.0.0.1:${CDP_PORT}/json/version`)).json();
+    const c = new Cdp();
+    c.ws = new WebSocket(ver.webSocketDebuggerUrl);
+    c.id = 0;
+    c.pending = new Map();
+    c.ws.onmessage = (e) => {
+      const m = JSON.parse(e.data);
+      const p = c.pending.get(m.id);
+      if (!p) return;
+      c.pending.delete(m.id);
+      m.error ? p.reject(new Error(JSON.stringify(m.error))) : p.resolve(m.result);
+    };
+    await new Promise((res, rej) => {
+      c.ws.onopen = res;
+      c.ws.onerror = rej;
+    });
+    return c;
+  }
+  send(method, params = {}, sessionId) {
+    const i = ++this.id;
+    return new Promise((resolve, reject) => {
+      this.pending.set(i, { resolve, reject });
+      this.ws.send(JSON.stringify({ id: i, method, params, ...(sessionId ? { sessionId } : {}) }));
+    });
+  }
+  async pages() {
+    return (await this.send('Target.getTargets')).targetInfos.filter((t) => t.type === 'page');
+  }
+  async session(targetId) {
+    return (await this.send('Target.attachToTarget', { targetId, flatten: true })).sessionId;
+  }
+  async evaluate(targetId, expression) {
+    const s = await this.session(targetId);
+    const r = await this.send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true }, s);
+    await this.send('Target.detachFromTarget', { sessionId: s });
+    if (r.exceptionDetails) throw new Error(r.exceptionDetails.text);
+    return r.result.value;
+  }
+  close() {
+    this.ws.close();
+  }
+}
+
+// /json/list also lists browser_ui targets such as the WebUI toolbar, which
+// Target.getTargets leaves out.
+const jsonList = async () => (await fetch(`http://127.0.0.1:${CDP_PORT}/json/list`)).json();
+
+// ---------------------------------------------------------------- UI DevTools
+
+class Views {
+  static async connect() {
+    const v = new Views();
+    v.ws = new WebSocket(`ws://127.0.0.1:${UIDT_PORT}/0`);
+    v.id = 0;
+    v.pending = new Map();
+    v.ws.onmessage = (e) => {
+      const m = JSON.parse(e.data);
+      if (m.id && v.pending.has(m.id)) {
+        v.pending.get(m.id)(m);
+        v.pending.delete(m.id);
+      }
+    };
+    await new Promise((res, rej) => {
+      v.ws.onopen = res;
+      v.ws.onerror = rej;
+    });
+    await v.send('DOM.enable');
+    await v.send('CSS.enable');
+    return v;
+  }
+  send(method, params = {}) {
+    const i = ++this.id;
+    return new Promise((resolve) => {
+      this.pending.set(i, resolve);
+      this.ws.send(JSON.stringify({ id: i, method, params }));
+    });
+  }
+  static name(n) {
+    const a = n.attributes ?? [];
+    for (let i = 0; i + 1 < a.length; i += 2) if (a[i] === 'name') return a[i + 1];
+    return n.nodeName;
+  }
+  async root() {
+    return (await this.send('DOM.getDocument')).result.root;
+  }
+  // Never call this on the document root: it hits NOTREACHED and kills the browser.
+  async props(node) {
+    const r = await this.send('CSS.getMatchedStylesForNode', { nodeId: node.nodeId });
+    const out = {};
+    for (const m of r.result?.matchedCSSRules ?? [])
+      for (const p of m.rule?.style?.cssProperties ?? []) out[p.name] = p.value;
+    return out;
+  }
+  async widgets() {
+    return ((await this.root()).children ?? []).map(Views.name);
+  }
+  async find(re) {
+    const hits = [];
+    const walk = (n, parent) => {
+      for (const c of n.children ?? []) {
+        if (re.test(Views.name(c))) hits.push({ node: c, parent });
+        walk(c, n);
+      }
+    };
+    walk(await this.root(), null);
+    return hits.map((h) => h.node);
+  }
+  async drawn(node) {
+    const p = await this.props(node);
+    return p.Visible === 'true' && p.IsDrawn === 'true';
+  }
+  // Texts of visible labels under the first view matching `re`, in tree order.
+  async texts(re) {
+    const [node] = await this.find(re);
+    if (!node) return null;
+    const out = [];
+    const walk = async (n) => {
+      const p = await this.props(n);
+      if (p.Visible === 'false') return;
+      if (p.Text) out.push(p.Text);
+      for (const c of n.children ?? []) await walk(c);
+    };
+    await walk(node);
+    return out;
+  }
+}
+
+// ---------------------------------------------------------------- fixtures
+
+function makeVideo() {
+  const file = path.join(work, 'h264.mp4');
+  try {
+    execFileSync('ffmpeg', ['-v', 'error', '-f', 'lavfi', '-i', 'testsrc=size=640x360:rate=30', '-t', '3',
+      '-c:v', 'libx264', '-pix_fmt', 'yuv420p', '-movflags', '+faststart', file]);
+    return file;
+  } catch {
+    return null;
+  }
+}
+
+function serve(video) {
+  const page = (title) => `<!doctype html><title>${title}</title><h1>${title}</h1>`;
+  const server = http.createServer((req, res) => {
+    const name = req.url.split('?')[0];
+    const m = name.match(/^\/(alpha|beta|gamma|delta|epsilon)\.html$/);
+    if (m) {
+      const title = `${m[1][0].toUpperCase()}${m[1].slice(1)} page`;
+      res.writeHead(200, { 'Content-Type': 'text/html' }).end(page(title));
+    } else if (name === '/file.zip') {
+      res.writeHead(200, {
+        'Content-Type': 'application/zip',
+        'Content-Disposition': 'attachment; filename="ide-smoke.zip"',
+      }).end(Buffer.alloc(150000, 7));
+    } else if (name === '/h264.mp4' && video) {
+      res.writeHead(200, { 'Content-Type': 'video/mp4' }).end(fs.readFileSync(video));
+    } else if (name === '/video.html') {
+      res.writeHead(200, { 'Content-Type': 'text/html' }).end('<!doctype html><title>Video page</title>');
+    } else {
+      res.writeHead(404).end();
+    }
+  });
+  return new Promise((r) => server.listen(HTTP_PORT, '127.0.0.1', () => r(server)));
+}
+
+// ---------------------------------------------------------------- capture
+
+function canCapture() {
+  const probe = path.join(work, 'probe.png');
+  try {
+    execFileSync('screencapture', ['-x', '-R0,0,200,200', probe]);
+    // Without Screen Recording permission macOS returns an all-black image,
+    // which compresses to almost nothing.
+    return fs.statSync(probe).size > 4000;
+  } catch {
+    return false;
+  }
+}
+
+let shotIndex = 0;
+let capture = false;
+function shot(label) {
+  if (!capture || !SHOTS) return;
+  const r = WINDOW;
+  const file = path.join(SHOTS, `${String(++shotIndex).padStart(2, '0')}-${label}.png`);
+  execFileSync('screencapture', ['-x', `-R${r.left},${r.top},${r.width},${r.height}`, file]);
+}
+
+// ---------------------------------------------------------------- checks
+
+const results = [];
+async function check(name, fn) {
+  try {
+    const detail = await fn();
+    results.push({ name, status: detail === 'SKIP' ? 'SKIP' : 'PASS', detail: detail === 'SKIP' ? '' : detail ?? '' });
+  } catch (e) {
+    results.push({ name, status: 'FAIL', detail: e.message });
+  }
+  const r = results.at(-1);
+  console.log(`${r.status.padEnd(4)}  ${name}${r.detail ? `  (${r.detail})` : ''}`);
+}
+const expect = (cond, msg) => {
+  if (!cond) throw new Error(msg);
+};
+
+async function waitFor(fn, timeout = 5000, step = 150) {
+  const end = Date.now() + timeout;
+  let last;
+  while (Date.now() < end) {
+    last = await fn();
+    if (last) return last;
+    await sleep(step);
+  }
+  return last;
+}
+
+async function main() {
+  try {
+    await fetch(`http://127.0.0.1:${CDP_PORT}/json/version`);
+    throw new Error(`port ${CDP_PORT} is already in use; quit the other debug browser first`);
+  } catch (e) {
+    if (e.message.startsWith('port')) throw e;
+  }
+  // A stock Chromium fails nearly every check with misleading messages.
+  if (plist('CrProductDirName') !== 'Chromium IDE') throw new Error(`${APP} is not the IDE build; pass --app`);
+  // Someone using this Mac takes focus mid-run and fails unrelated checks.
+  const idle = Number(/"HIDIdleTime" = (\d+)/.exec(execFileSync('ioreg', ['-c', 'IOHIDSystem'], { encoding: 'utf8' }))?.[1] ?? Infinity) / 1e9;
+  if (idle < 60 && !argv.includes('--force')) {
+    throw new Error(`this Mac had input ${Math.round(idle)}s ago; run it when nobody is using it, or pass --force`);
+  }
+  // A locked screen blocks activation, so every keyboard check would fail.
+  const locked = execFileSync('osascript', ['-l', 'JavaScript', '-e',
+    'ObjC.import("CoreGraphics"); String(ObjC.deepUnwrap(ObjC.castRefToObject($.CGSessionCopyCurrentDictionary())).CGSSessionScreenIsLocked === true)'],
+  { encoding: 'utf8' }).trim();
+  if (locked === 'true') throw new Error('the screen is locked; unlock it first');
+  if (SHOTS) fs.mkdirSync(SHOTS, { recursive: true });
+  capture = canCapture();
+  if ((SHOTS || VIDEO) && !capture) {
+    console.log('note: no Screen Recording permission, screenshots and video are skipped');
+  }
+
+  const crashesBefore = fs.existsSync(CRASH_DIR) ? fs.readdirSync(CRASH_DIR).length : 0;
+  const video = makeVideo();
+  const server = await serve(video);
+  const profile = path.join(work, 'profile');
+  const downloads = path.join(work, 'downloads');
+  fs.mkdirSync(downloads);
+
+  console.log(`${PROC} smoke test: ${APP}\nThe browser will take focus for about two minutes.`);
+  execFileSync('open', ['-na', APP, '--args', `--user-data-dir=${profile}`, '--use-mock-keychain',
+    '--no-first-run', '--no-default-browser-check', `--remote-debugging-port=${CDP_PORT}`,
+    `--enable-ui-devtools=${UIDT_PORT}`, `${BASE}/alpha.html`, `${BASE}/beta.html`, `${BASE}/gamma.html`]);
+
+  const up = await waitFor(async () => {
+    try {
+      return (await fetch(`http://127.0.0.1:${CDP_PORT}/json/version`)).ok;
+    } catch {
+      return false;
+    }
+  }, 30000, 500);
+  expect(up, 'browser did not start');
+  const cdp = await Cdp.connect();
+  await waitFor(async () => (await cdp.pages()).filter((p) => p.title.endsWith('page')).length === 3, 15000);
+  const first = (await cdp.pages())[0];
+  const { windowId } = await cdp.send('Browser.getWindowForTarget', { targetId: first.targetId });
+  await cdp.send('Browser.setWindowBounds', { windowId, bounds: WINDOW });
+  await cdp.send('Browser.setDownloadBehavior', { behavior: 'allow', downloadPath: downloads, eventsEnabled: true });
+  const views = await Views.connect();
+  frontmost();
+  await sleep(800);
+
+  let recorder = null;
+  if (VIDEO && capture) {
+    const r = WINDOW;
+    recorder = spawn('screencapture', ['-v', '-x', `-R${r.left},${r.top},${r.width},${r.height}`, VIDEO], { stdio: 'ignore' });
+  }
+
+  const paletteRows = async () => (await views.texts(/^PaletteContents$/)) ?? [];
+  const openPalette = async (mods) => {
+    key(mods.code, mods.keys);
+    expect(await waitFor(async () => (await views.find(/^PaletteContents$/)).length > 0), 'palette did not open');
+  };
+  const goto = async (query) => {
+    await openPalette({ code: KC.t, keys: ['command'] });
+    await paste(query);
+    await sleep(500);
+    key(KC.ret);
+    await sleep(800);
+  };
+
+  await check('layout: no tab strip, avatar, app menu or bookmark bar', async () => {
+    for (const re of [/^TabStrip$/, /TabStripRegionView/, /^AvatarToolbarButton$/, /^BrowserAppMenuButton$/, /^BookmarkBarView$/])
+      for (const n of await views.find(re)) expect(!(await views.drawn(n)), `${Views.name(n)} is drawn`);
+    shot('window');
+  });
+
+  await check('layout: centered URL, left while editing', async () => {
+    const [omnibox] = await views.find(/^OmniboxViewViews$/);
+    expect((await views.props(omnibox)).HorizontalAlignment === 'ALIGN_CENTER', 'not centered at rest');
+    key(KC.l, ['command']);
+    await sleep(400);
+    const editing = (await views.props(omnibox)).HorizontalAlignment;
+    key(KC.esc);
+    key(KC.esc);
+    await sleep(300);
+    expect(editing === 'ALIGN_LEFT', `editing alignment ${editing}`);
+  });
+
+  await check('layout: Downloads pinned and drawn, no trailing divider', async () => {
+    let found = false;
+    for (const n of await views.find(/^PinnedActionToolbarButton$/)) {
+      const p = await views.props(n);
+      if (p.TooltipText === 'Downloads') found = p.IsDrawn === 'true';
+    }
+    expect(found, 'Downloads button not drawn');
+    const [container] = await views.find(/^PinnedToolbarActionsContainer$/);
+    for (const c of container.children ?? [])
+      if (Views.name(c) === 'ToolbarDivider') expect(!(await views.drawn(c)), 'divider drawn');
+  });
+
+  await check('layout: back, forward, reload only', async () => {
+    const toolbar = (await jsonList()).find((t) => t.url.startsWith('chrome://webui-toolbar'));
+    expect(toolbar, 'WebUI toolbar target missing');
+    const buttons = await cdp.evaluate(toolbar.id, `(() => {
+      const out = {};
+      const walk = (r) => { for (const e of r.querySelectorAll('*')) {
+        if (e.shadowRoot) walk(e.shadowRoot);
+        const label = e.getAttribute && (e.getAttribute('aria-label') || e.title);
+        if (e.tagName === 'CR-ICON-BUTTON' && label) out[label] = e.getBoundingClientRect().width;
+      } };
+      walk(document);
+      return out;
+    })()`);
+    for (const label of ['Back', 'Forward', 'Reload']) expect(buttons[label] > 0, `${label} hidden`);
+    for (const [label, width] of Object.entries(buttons))
+      if (!['Back', 'Forward', 'Reload'].includes(label)) expect(width === 0, `${label} visible`);
+  });
+
+  await check('menu: Go to Anything and Command Palette enabled with shortcuts', async () => {
+    const out = osa(
+      `tell application "System Events" to tell process "${PROC}"`,
+      'set m to menu "File" of menu bar item "File" of menu bar 1',
+      'set a to menu item "Go to Anything…" of m',
+      'set b to menu item "Command Palette…" of m',
+      'return {enabled of a, value of attribute "AXMenuItemCmdChar" of a, enabled of b, value of attribute "AXMenuItemCmdChar" of b}',
+      'end tell',
+    );
+    expect(out === 'true, T, true, P', out);
+  });
+
+  await check('branding: app menu uses the product name', async () => {
+    const out = osa(
+      `tell application "System Events" to tell process "${PROC}"`,
+      'return name of menu items of menu 1 of menu bar item 2 of menu bar 1',
+      'end tell',
+    );
+    expect(out.includes(`About ${PROC}`) && out.includes(`Quit ${PROC}`), out);
+  });
+
+  const titles = async () => (await cdp.pages()).map((p) => p.title);
+
+  await check('Cmd+T: switches to an open tab', async () => {
+    const target = windowTitle().startsWith('Gamma') ? 'beta' : 'gamma';
+    await openPalette({ code: KC.t, keys: ['command'] });
+    await paste(target);
+    await sleep(500);
+    const rows = await paletteRows();
+    shot('goto-anything');
+    expect(rows.includes('OPEN TABS'), `rows: ${rows.join(' | ')}`);
+    key(KC.ret);
+    await sleep(800);
+    const want = `${target[0].toUpperCase()}${target.slice(1)} page`;
+    expect(windowTitle().startsWith(want), `active: ${windowTitle()}`);
+    expect((await titles()).length === 3, 'a tab was opened');
+  });
+
+  await check('Cmd+T: URL opens a new tab', async () => {
+    await goto(`127.0.0.1:${HTTP_PORT}/delta.html`);
+    expect(await waitFor(async () => windowTitle().startsWith('Delta page')), `active: ${windowTitle()}`);
+    expect((await titles()).length === 4, 'no new tab');
+  });
+
+  await check('Cmd+T: recently closed', async () => {
+    key(KC.w, ['command']);
+    await sleep(700);
+    await openPalette({ code: KC.t, keys: ['command'] });
+    await paste('delta');
+    await sleep(500);
+    const rows = await paletteRows();
+    const listed = rows.includes('RECENTLY CLOSED') && rows.includes('Delta page');
+    key(listed ? KC.ret : KC.esc);
+    expect(listed, `rows: ${rows.join(' | ')}`);
+    const reopened = await waitFor(async () => windowTitle().startsWith('Delta page'));
+    expect(reopened, `active: ${windowTitle()}`);
+    // Later checks expect exactly alpha, beta and gamma.
+    key(KC.w, ['command']);
+    await sleep(700);

  private:
+  void AddPreview(views::View* parent) {
+    auto* preview = parent->AddChildView(std::make_unique<views::View>());
+    preview->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+    auto* frame = preview->AddChildView(std::make_unique<views::View>());
+    frame->SetPreferredSize(kPreviewSize);
+    frame->SetLayoutManager(std::make_unique<views::FillLayout>());
+    frame->SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSubtleEmphasisBackground, kRowRadius));
+    frame->SetPaintToLayer();
+    frame->layer()->SetFillsBoundsOpaquely(false);
+    frame->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kRowRadius));
+    frame->layer()->SetMasksToBounds(true);
+    preview_icon_ = frame->AddChildView(std::make_unique<views::ImageView>());
+    preview_icon_->SetImageSize(gfx::Size(kPreviewIconSize, kPreviewIconSize));
+    preview_thumbnail_ =
+        frame->AddChildView(std::make_unique<views::ImageView>());
+    preview_thumbnail_->SetImageSize(kPreviewSize);
+    preview_thumbnail_->SetVisible(false);
+    preview_title_ = preview->AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_LABEL,
+        views::style::STYLE_PRIMARY));
+    preview_url_ = preview->AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    for (views::Label* label : {preview_title_.get(), preview_url_.get()}) {
+      label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      label->SetElideBehavior(gfx::ELIDE_TAIL);
+      label->SetMaximumWidthSingleLine(kPreviewSize.width());
+    }
+  }
+
+  // A tab restored from the last session has not loaded yet, and observing
+  // its thumbnail would load it.
+  static scoped_refptr<ThumbnailImage> ThumbnailFor(const Item& item) {
+    content::WebContents* contents = item.contents.get();
+    if (item.kind != Item::Kind::kOpenTab || !contents ||
+        (contents->GetController().NeedsReload() &&
+         !contents->WasDiscarded())) {
+      return nullptr;
+    }
+    tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+    ThumbnailTabHelper* helper = tab ? ThumbnailTabHelper::From(tab) : nullptr;
+    return helper ? helper->thumbnail() : nullptr;
+  }
+
+  // Shows the selected row's icon until its tab's thumbnail arrives.
+  void UpdatePreview() {
+    if (!preview_icon_) {
+      return;
+    }
+    const Item* item = selected_ < shown_.size() ? &shown_[selected_] : nullptr;
+    preview_title_->SetText(item ? item->row.title : std::u16string());
+    preview_url_->SetText(item ? item->row.detail : std::u16string());
+    scoped_refptr<ThumbnailImage> thumbnail =
+        item ? ThumbnailFor(*item) : nullptr;
+    // The list is rebuilt as history results arrive; the tab still selected
+    // keeps the image it shows.
+    if (thumbnail && thumbnail == thumbnail_) {
+      return;
+    }
+    preview_icon_->SetImage(item ? item->row.icon : ui::ImageModel());
+    preview_icon_->SetVisible(true);
+    preview_thumbnail_->SetVisible(false);
+    subscription_.reset();
+    thumbnail_ = std::move(thumbnail);
+    if (!thumbnail_) {
+      return;
+    }
+    subscription_ = thumbnail_->Subscribe();
+    subscription_->SetSizeHint(kPreviewSize);
+    subscription_->SetUncompressedImageCallback(base::BindRepeating(
+        &PaletteContents::OnThumbnail, base::Unretained(this),
+        base::Unretained(thumbnail_.get())));
+    thumbnail_->RequestThumbnailImage();
+  }
+
+  void OnThumbnail(const ThumbnailImage* thumbnail, gfx::ImageSkia image) {
+    if (thumbnail != thumbnail_.get() || image.isNull()) {
+      return;
+    }
+    preview_thumbnail_->SetImage(ui::ImageModel::FromImageSkia(image));
+    preview_thumbnail_->SetVisible(true);
+    preview_icon_->SetVisible(false);
+  }
+

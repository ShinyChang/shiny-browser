From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shiny <owner@shinychang.net>
Date: Wed, 28 Oct 2026 21:33:24 +0800
Subject: [PATCH] feat: copy the URL from a link button in the location bar

- While the pointer is over the location bar and the address is not
  being edited, a link button at its end copies the address.
- A click on the address edits it, as in Chrome.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BYkQJUafT3hpFT1kBmDgzX
---
 .../views/location_bar/location_bar_view.cc   | 40 +++++++++++++++++++
 .../ui/views/location_bar/location_bar_view.h |  3 ++
 2 files changed, 43 insertions(+)

diff --git a/chrome/browser/ui/views/location_bar/location_bar_view.cc b/chrome/browser/ui/views/location_bar/location_bar_view.cc
index d07cbfe86c..d59c795545 100644
--- a/chrome/browser/ui/views/location_bar/location_bar_view.cc
+++ b/chrome/browser/ui/views/location_bar/location_bar_view.cc
@@ -17,6 +17,7 @@
 #include "base/metrics/field_trial_params.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
+#include "chrome/app/chrome_command_ids.h"
 #include "chrome/app/vector_icons/vector_icons.h"
 #include "chrome/browser/actor/ui/actor_ui_window_controller.h"
 #include "chrome/browser/autocomplete/aim_eligibility_service_factory.h"
@@ -32,6 +33,7 @@
 #include "chrome/browser/translate/translate_service.h"
 #include "chrome/browser/ui/actions/chrome_action_id.h"
 #include "chrome/browser/ui/browser_actions.h"
+#include "chrome/browser/ui/browser_commands.h"
 #include "chrome/browser/ui/browser_element_identifiers.h"
 #include "chrome/browser/ui/browser_window.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_features.h"
@@ -96,6 +98,7 @@
 #include "chrome/common/chrome_features.h"
 #include "chrome/grit/generated_resources.h"
 #include "chrome/grit/omnibox_popup_resources.h"
+#include "components/vector_icons/vector_icons.h"
 #include "components/commerce/core/commerce_feature_list.h"
 #include "components/content_settings/core/browser/host_content_settings_map.h"
 #include "components/content_settings/core/common/features.h"
@@ -513,6 +516,27 @@ void LocationBarView::Init() {
   clear_all_button_ = AddChildView(std::move(clear_all_button));
   RefreshClearAllButtonIcon();
 
+  // Shy copies the address from a button shown while the pointer is over the location bar, so a
+  // click on the address still edits it.
+  auto copy_link_button = views::CreateVectorImageButton(base::BindRepeating(
+      [](LocationBarView* view) {
+        if (view->browser()) {
+          chrome::ExecuteCommand(view->browser(), IDC_COPY_URL);
+        }
+      },
+      base::Unretained(this)));
+  copy_link_button->SetTooltipText(u"Copy link");
+  copy_link_button->SetVisible(false);
+  copy_link_button_ = AddChildView(std::move(copy_link_button));
+  SetImageFromVectorIconWithColor(
+      copy_link_button_, vector_icons::kLinkIcon,
+      {kColorLocationBarClearAllButtonIcon,
+       kColorLocationBarClearAllButtonIconDisabled});
+  copy_link_button_->SetBorder(views::CreateEmptyBorder(
+      GetLayoutInsets(LOCATION_BAR_ICON_INTERIOR_PADDING)));
+  // Moving off the bar from over the button has to reach this view too, to hide the button.
+  SetNotifyEnterExitOnChild(true);
+
   auto ai_mode_hint_label = std::make_unique<views::Label>(
       std::u16string(), CONTEXT_OMNIBOX_PRIMARY, views::style::STYLE_PRIMARY);
   ai_mode_hint_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
@@ -951,6 +975,8 @@ void LocationBarView::Layout(PassKey) {
 
   add_trailing_decoration(clear_all_button_, /*intra_item_padding=*/0,
                           /*edge_padding=*/trailing_decorations_edge_padding);
+  add_trailing_decoration(copy_link_button_, /*intra_item_padding=*/0,
+                          /*edge_padding=*/trailing_decorations_edge_padding);
 
   // Perform layout.
   int entry_width = width();
@@ -2148,6 +2174,7 @@ void LocationBarView::OnChanged() {
       GetOmniboxController()->edit_model()->user_input_in_progress() &&
       !omnibox_view_->GetText().empty() &&
       IsVirtualKeyboardVisible(GetWidget()));
+  UpdateCopyLinkButton(copy_link_button_->GetVisible());
 
   InvalidateLayout();
   SchedulePaint();
@@ -2179,6 +2206,7 @@ void LocationBarView::OnOmniboxFocused() {
   // The AI mode page action should only be visible when the omnibox
   // is focused, so if there is a change in focus, refresh the icon.
   RefreshAiModePageAction();
+  UpdateCopyLinkButton(false);
 }
 
 void LocationBarView::OpenOmniboxPopup(bool query_zps) {
@@ -2191,6 +2219,7 @@ void LocationBarView::OpenOmniboxPopup(bool query_zps) {
 }
 
 void LocationBarView::OnOmniboxBlurred() {
+  UpdateCopyLinkButton(IsMouseHovered());
   if (views::FocusRing::Get(this)) {
     views::FocusRing::Get(this)->Refresh();
   }
@@ -2217,6 +2246,17 @@ void LocationBarView::OnOmniboxHovered(bool is_hovering) {
   } else {
     hover_animation_.Hide();
   }
+  // Leaving the text for the button itself counts as an exit, though the pointer is still here.
+  UpdateCopyLinkButton(is_hovering || IsMouseHovered());
+}
+
+void LocationBarView::UpdateCopyLinkButton(bool hovered) {
+  const bool show = hovered && omnibox_view_ && !omnibox_view_->HasFocus() &&
+                    !omnibox_view_->GetText().empty();
+  if (copy_link_button_->GetVisible() != show) {
+    copy_link_button_->SetVisible(show);
+    InvalidateLayout();
+  }
 }
 
 void LocationBarView::OnTouchUiChanged() {
diff --git a/chrome/browser/ui/views/location_bar/location_bar_view.h b/chrome/browser/ui/views/location_bar/location_bar_view.h
index 317211c69c..0cccf460b1 100644
--- a/chrome/browser/ui/views/location_bar/location_bar_view.h
+++ b/chrome/browser/ui/views/location_bar/location_bar_view.h
@@ -378,6 +378,7 @@ class LocationBarView
 
   // Updates the color of the icon for the "clear all" button.
   void RefreshClearAllButtonIcon();
+  void UpdateCopyLinkButton(bool hovered);
 
   // Returns true if a keyword is selected in the model.
   bool ShouldShowKeywordBubble() const;
@@ -620,6 +621,8 @@ class LocationBarView
   // user to clear all text.
   raw_ptr<views::ImageButton> clear_all_button_ = nullptr;
 
+  raw_ptr<views::ImageButton> copy_link_button_ = nullptr;
+
   // A label to show the AI Mode hint text.
   raw_ptr<views::Label> ai_mode_hint_label_ = nullptr;
 

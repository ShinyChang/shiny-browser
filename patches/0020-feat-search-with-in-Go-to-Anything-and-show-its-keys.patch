         (static_cast<int>(selected_) + delta + count) % count));
   }
 
+  // A keycap pairs each key with its action; the tab count is status, not a
+  // key, so it stands apart on the right.
+  void UpdateFooter() {
+    footer_->RemoveAllChildViews();
+    std::vector<std::pair<std::u16string, std::u16string>> hints;
+    if (mode_ == PaletteMode::kGoto) {
+      hints.emplace_back(u"↵", u"open");
+      if (has_navigate_item_ && !navigate_first_) {
+        hints.emplace_back(u"⌘↵", u"search");
+      }
+      hints.emplace_back(u"⌘⇧P", u"commands");
+    } else {
+      hints.emplace_back(u"↵", u"run");
+      hints.emplace_back(u"⌘T", u"tabs and URLs");
+    }
+    for (const auto& [keys, action] : hints) {
+      auto* hint = footer_->AddChildView(std::make_unique<views::View>());
+      hint->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+              kKeyGap))
+          ->set_cross_axis_alignment(
+              views::BoxLayout::CrossAxisAlignment::kCenter);
+      auto* key = hint->AddChildView(std::make_unique<views::Label>(
+          keys, views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+      key->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(1, 5)));
+      key->SetBackground(views::CreateRoundedRectBackground(
+          ui::kColorSubtleEmphasisBackground, kKeyRadius));
+      hint->AddChildView(std::make_unique<views::Label>(
+          action, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    }
+    if (mode_ == PaletteMode::kGoto) {
+      auto* count = footer_->AddChildView(std::make_unique<views::Label>(
+          base::NumberToString16(tab_count_) + u" tabs open",
+          views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      count->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+      footer_layout_->SetFlexForView(count, 1);
+    }
+  }
+
   void Accept(size_t index) {
     if (index >= shown_.size()) {
       return;
     }
+    AcceptItem(shown_[index]);
+  }
+
+  void AcceptItem(const Item& item) {
     // Run after the bubble has gone so focus restoration cannot undo what the
     // action focuses (find bar, location bar, a new tab).
     base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
-        FROM_HERE, base::BindOnce(&ActOn, base::Unretained(browser_.get()),
-                                  shown_[index]));
+        FROM_HERE,
+        base::BindOnce(&ActOn, base::Unretained(browser_.get()), item));
     GetWidget()->Close();
   }
 

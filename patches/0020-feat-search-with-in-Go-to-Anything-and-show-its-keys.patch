+  raw_ptr<views::BoxLayout> footer_layout_ = nullptr;
   raw_ptr<views::ImageView> preview_icon_ = nullptr;
   raw_ptr<views::ImageView> preview_thumbnail_ = nullptr;
   raw_ptr<views::Label> preview_title_ = nullptr;

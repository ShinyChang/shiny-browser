{
  "manifest_version": 3,
  "name": "Talk to Shy",
  "version": "0.2.1",
  "description": "Lets an agent you trust read and use the sites you allow, with every call shown in a side panel.",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Talk to Shy",
    "default_icon": "icon.png"
  }
}
